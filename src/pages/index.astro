---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";

console.log("This runs in your terminal, not the browser!");
---

<html>
    <BaseHead />
    <body>
        <script is:inline src="/matter/matter.js"></script>
        <Navbar />
        <section class="hero">
            <div class="container">
                <div class="title-container">
                    <h1 class="title">Hasbi Ardianto Pratama</h1>
                </div>
                <div class="desc-container">
                    <p class="desc">
                        A passionate person who focuses on software development,
                        AI exploration, and technology education.
                    </p>
                </div>
            </div>
        </section>
        <canvas id="matter-canvas"></canvas>
        <script src="/src/playground/index.js"></script>
    </body>
</html>
<style>
    :global(body) {
        position: relative;
    }
    .hero {
        display: flex;
    }
    .container {
        max-width: 750px;
        margin: auto;
        padding: 0 20px;
    }
    .title {
        text-align: center;
        font-size: 50px;
        font-weight: 700;
        color: rgb(70, 63, 50);
    }
    .desc {
        text-align: center;
        margin-top: 10px;
        color: rgb(70, 63, 50);
    }
    canvas {
        position: sticky;
        left: 0;
        bottom: 0;
        z-index: -1;
        height: 100vh;
        border: 1px red dashed;
    }
    ul {
        list-style: none;
    }
    li {
        border: 1px solid rgb(70, 63, 50);
        border-radius: 5px;
        background-color: #fefefe;
        display: inline-block;
        padding: 10px 20px;
        margin: 10px 0;
    }
    a {
        color: rgb(70, 63, 50);
        text-decoration: none;
        font-weight: 500;
    }
    p {
        font-size: 1.2rem;
        color: rgb(70, 63, 50);
    }
</style>
