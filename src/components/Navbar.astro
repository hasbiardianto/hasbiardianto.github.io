---
interface Props {
    basePath?: string;
}

const { basePath = "" } = Astro.props;
---

<header class="site-header">
    <a class="brand" href={`${basePath}#home`} aria-label="Hasbi Ardianto, home">HA<span>.</span></a>
    <nav class="site-nav" aria-label="Main navigation">
        <a href={`${basePath}#about`}>About</a>
        <a href={`${basePath}#work`}>Work</a>
        <a href={`${basePath}#practice`}>Practice</a>
        <a href={`${basePath}#experience`}>Experience</a>
    </nav>
    <a class="header-contact" href={`${basePath}#contact`}>
        <span class="header-contact-dot"></span>
        Let’s talk <span aria-hidden="true">↗</span>
    </a>
</header>
